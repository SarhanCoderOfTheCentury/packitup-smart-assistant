# ============================================================================
# PackItUp Smart Shopping Assistant — Environment Configuration (.env)
# ============================================================================

# 1. Google Gemini API (Required for live Gemini LLM synthesis & embeddings)
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-001"
GEMINI_TEMPERATURE="0.1"

# 2. Execution Mode ("direct" for all-in-one Streamlit Cloud; "fastapi" for decoupled API)
AGENT_EXECUTION_MODE="direct"
FASTAPI_URL="http://localhost:8000"

# 3. Local Storage Paths
PACKITUP_DATA_DIR="./data/packitup"
CHROMA_PERSIST_DIR="./data/chroma_db"
CHROMA_COLLECTION_NAME="packitup_knowledge"
LEADS_CSV_PATH="./data/leads.csv"

# 4. Shopify Storefront & Admin API (For Live Production Cutover on packitup.com.pk)
SHOPIFY_STORE_DOMAIN="packitup.com.pk"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-01"
SHOPIFY_MCP_ENDPOINT="https://packitup.com.pk/api/ucp/mcp"

# 5. Meta WhatsApp Business Cloud API (Graph API v21.0)
WHATSAPP_VERIFY_TOKEN="packitup_verify_secret_2026"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_SALES_ALERT_PHONE="+923222620169"
